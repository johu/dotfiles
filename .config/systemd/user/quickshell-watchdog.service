[Unit]
Description=Restart quickshell when a real monitor reappears after idle
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/quickshell-watchdog.sh
Restart=always
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
